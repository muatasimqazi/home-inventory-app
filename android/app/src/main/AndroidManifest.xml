<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google sign-in's own callback (components/native-auth-
                 deep-link-listener.tsx) — routes com.schuaz.app://... back
                 into this same activity instead of leaving the user in
                 the Custom Tab that ran the OAuth flow. custom_url_scheme
                 (strings.xml) is the same value Capacitor set to this
                 app's own appId by default. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Capture flows use getUserMedia() directly in the WebView (no
         @capacitor/camera plugin — see docs/Mobile App Addendum.md §2.2),
         which still needs these declared so Android's runtime permission
         prompt has something to grant. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- "Use my location" (household location, set-household-location-
         sheet.tsx) uses navigator.geolocation directly, same reasoning. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 13+ requires this to actually display a notification —
         @capacitor/push-notifications' requestPermissions() prompts for
         it (docs/Mobile App Addendum.md §2.1, hooks/use-native-push-
         notifications.ts). On Android 12 and below it's a no-op; the
         plugin's own checkPermissions() already reports "granted" there
         regardless. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice input (docs/Voice Input Addendum.md) uses getUserMedia()/
         MediaRecorder directly in the WebView, same "no native plugin
         needed" reasoning as camera/location above. Capacitor's built-in
         WebView permission handling (BridgeWebChromeClient.
         onPermissionRequest, @capacitor/android) requests BOTH of these
         together for an audio-capture request and only grants the WebView
         the mic if *both* come back granted — MODIFY_AUDIO_SETTINGS is a
         "normal" (non-dangerous) permission so it never shows its own
         prompt, but omitting it from the manifest still makes that half
         of the request come back denied, which silently failed the whole
         getUserMedia call even after RECORD_AUDIO's own prompt was
         accepted (VoiceInputButton's error icon, with no visible second
         prompt to explain why). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
