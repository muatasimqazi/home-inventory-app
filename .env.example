# Copy to .env.local and fill in real values. Not committed (.gitignore).
# The app runs fine with none of these set — it uses an in-memory mock store
# and MockVisionProvider by default. These are only needed once the real
# Supabase/Gemini backend work begins (see lib/supabase/, lib/gemini/).

# Supabase — new API key model. Do NOT use legacy `anon` / `service_role` names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini — server-only, never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

NEXT_PUBLIC_APP_URL=

# Optional / later
CRON_SECRET=
EXPORT_SIGNING_SECRET=
