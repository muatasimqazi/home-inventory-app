# Copy to .env.local and fill in real values. Not committed (.gitignore).
# The app runs fine with none of these set — it uses an in-memory mock store
# and MockVisionProvider by default. These are only needed once the real
# Supabase backend work begins (see lib/supabase/).

# Supabase — new API key model. Do NOT use legacy `anon` / `service_role` names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vision detection (lib/vision/detect.ts) runs through Vercel AI Gateway —
# no key to set here. Locally, `vercel env pull` provisions VERCEL_OIDC_TOKEN
# automatically; on Vercel deployments it's automatic. AI_GATEWAY_API_KEY is
# only needed for a static key outside a Vercel-linked environment (CI, etc).

NEXT_PUBLIC_APP_URL=

# Optional / later
CRON_SECRET=
EXPORT_SIGNING_SECRET=
